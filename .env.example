# ==============================================================================
# Belajar PostgreSQL Golang Environment Configuration (Example)
# ==============================================================================

# Application Settings
ADDR=:8080
BASE_PATH=/belajar-pgsql-golang
AUTO_SEED=true

# Database Settings (Shared Reusable PostgreSQL)
POSTGRES_HOST=reusable-postgres
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=playground

DATABASE_URL=postgres://app:app@reusable-postgres:5432/playground?sslmode=disable
